rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own user document
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Submissions: authenticated users can create, anyone can read
    match /submissions/{submissionId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Problem stats: anyone can read, authenticated users can update
    match /problem_stats/{problemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Discussions: authenticated users can create/update, anyone can read
    match /discussions/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }
  }
}
